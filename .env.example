# Copy to .env and fill in. Everything is optional: without Neo4j/Ollama the app runs in fallback mode.

# Neo4j (Desktop, Docker, or Aura). Leave NEO4J_PASSWORD empty to use the in-memory graph.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
USE_NEO4J=auto

# Ollama running Mistral (`ollama pull mistral`). USE_LLM=false forces extractive/template mode.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral
USE_LLM=auto

TELEMETRY_INTERVAL=3
